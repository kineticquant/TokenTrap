{
  "name": "tokentrap-ai",
  "version": "1.0.1",
  "description": "Defensive LLM agent honeypot chat widget - traps nefarious AI agents into burning their own tokens. Client-side, Cloudflare Workers, or full backend.",
  "license": "MIT",
  "author": "TokenTrap contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineticquant/TokenTrap.git"
  },
  "keywords": [
    "honeypot",
    "tarpit",
    "llm",
    "security",
    "prompt-injection",
    "ai-agents",
    "defense"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cdn.global.js",
  "jsdelivr": "./dist/cdn.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs",
      "default": "./dist/engine.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size-report.mjs"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
