{
  "name": "tokentrap-ai",
  "version": "1.1.0",
  "description": "Defensive LLM agent honeypot chat widget - traps nefarious AI agents into burning their own tokens. Client-side, Cloudflare Workers, or full backend.",
  "license": "MIT",
  "author": "kineticquant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineticquant/TokenTrap.git"
  },
  "keywords": [
    "honeypot",
    "tarpit",
    "llm",
    "llm-security",
    "ai-security",
    "ai-agents",
    "ai-safety",
    "cybersecurity",
    "prompt-injection",
    "php2shell",
    "cve-2026-109618",
    "cve-2026-109619",
    "http-honeypot",
    "defense"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cdn.global.js",
  "jsdelivr": "./dist/cdn.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs",
      "default": "./dist/engine.js"
    },
    "./php2shell": {
      "types": "./dist/php2shell.d.ts",
      "import": "./dist/php2shell.js",
      "require": "./dist/php2shell.cjs",
      "default": "./dist/php2shell.js"
    },
    "./php2shell/node": {
      "types": "./dist/php2shell-node.d.ts",
      "import": "./dist/php2shell-node.js",
      "require": "./dist/php2shell-node.cjs",
      "default": "./dist/php2shell-node.js"
    }
  },
  "bin": {
    "tokentrap-php2shell": "./dist/php2shell-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size-report.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
